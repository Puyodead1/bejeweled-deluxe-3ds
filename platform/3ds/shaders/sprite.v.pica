; Sprite vertex shader for the 3DS renderer.
; In:  v0 = position in pixels (x, y, z), v1 = texture coordinate (s, t), v2 = colour as 4 unsigned bytes (R, G, B, A).
; Out: clip-space position, texcoord0, colour scaled to 0..1.

.fvec projection[4]

.constf ones(1.0, 1.0, 1.0, 1.0)
.constf byte_to_float(0.00392156862745, 0.00392156862745, 0.00392156862745, 0.00392156862745)

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2

.proc main
	mov r0.xyz, inpos
	mov r0.w, ones

	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	mov outtc0, intex
	mul outclr, byte_to_float, inclr

	end
.end
